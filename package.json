{
  "name": "pringles-map",
  "version": "1.0.0",
  "private": true,
  "description": "A personal Pringles checklist with local ratings and notes.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
